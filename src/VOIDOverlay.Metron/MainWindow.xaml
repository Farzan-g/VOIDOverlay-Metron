<Window x:Class="VOIDOverlay.Metron.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VOID Overlay Metron"
        Icon="pack://application:,,,/assets/Metron.ico"
        Width="410"
        Height="42"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        WindowStartupLocation="Manual">
    <Border x:Name="OverlaySurface"
            Background="#80111720"
            CornerRadius="5"
            Padding="10,4">
        <StackPanel x:Name="MetricsPanel"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
            <TextBlock x:Name="CpuText" Foreground="#4DE3D2" Margin="0,0,8,0" />
            <TextBlock x:Name="GpuText" Foreground="#FFAE5C" Margin="0,0,8,0" />
            <TextBlock x:Name="RamText" Foreground="#F2F4F7" Margin="0,0,8,0" />
            <TextBlock x:Name="FpsText" Foreground="#F2F4F7" />
        </StackPanel>
    </Border>
</Window>
