<Window x:Class="VOIDOverlay.Metron.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VOIDOverlay Metron"
        Icon="pack://application:,,,/assets/Metron.ico"
        Width="410"
        Height="38"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        WindowStartupLocation="Manual">
    <Border Background="#80111720"
            CornerRadius="5"
            Padding="10,4"
            IsHitTestVisible="False">
        <StackPanel x:Name="MetricsPanel"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
            <TextBlock x:Name="CpuText" Foreground="#4DE3D2" />
            <TextBlock x:Name="GpuText" Foreground="#FFAE5C" />
            <TextBlock x:Name="RamText" Foreground="#F2F4F7" />
            <TextBlock x:Name="FpsText" Foreground="#F2F4F7" />
        </StackPanel>
    </Border>
</Window>
